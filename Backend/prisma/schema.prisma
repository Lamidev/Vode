datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ONBOARDING_NAME
  ONBOARDING_BVN
  ONBOARDING_PIN
  ACTIVE
  FROZEN
  SUSPENDED
}

enum KycTier {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

enum TransactionType {
  TRANSFER_OUT
  TRANSFER_IN
  BILL_PAYMENT
  AIRTIME
  DATA_BUNDLE
  ACCOUNT_FUNDING
  FEE
  REVERSAL
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum TokenType {
  ONBOARDING
  PIN_AUTHORIZATION
  EMERGENCY_UNFREEZE
}

model User {
  id                String             @id @default(cuid())
  phoneNumber       String             @unique // E.164 format: e.g. +2348012345678
  whatsappId        String             @unique // Meta WABA sender ID
  fullName          String?
  bvn               String?            // Encrypted Tier-1 BVN
  bvnLast4          String?            // Last 4 digits for zero-SMS emergency freeze check
  nin               String?            // Encrypted Tier-1 NIN
  pinHash           String?            // Hashed 4-digit transaction PIN (bcrypt/argon2)
  pinFailedAttempts Int                @default(0)
  pinLockedUntil    DateTime?
  status            UserStatus         @default(ONBOARDING_NAME)
  kycTier           KycTier            @default(TIER_0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  wallet              Wallet?
  dedicatedNubans     DedicatedNuban[]
  transactions        Transaction[]
  ephemeralTokens     EphemeralToken[]
  beneficiaries       Beneficiary[]
  emergencyFreezeLogs EmergencyFreezeLog[]

  @@index([phoneNumber])
  @@index([whatsappId])
  @@index([status])
}

model Wallet {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceInKobo     BigInt             @default(0) // Integer kobo (1 NGN = 100 kobo)
  currency          String             @default("NGN")
  isLocked          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  ledgerEntries     LedgerEntry[]

  @@index([userId])
}

model DedicatedNuban {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber     String             @unique // 10-digit Nigerian NUBAN
  accountName       String
  bankName          String             // e.g. "Safe Haven MFB" or "Providus Bank"
  bankCode          String             // 6-digit CBN/NIP bank code
  partnerReference  String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([accountNumber])
}

model Transaction {
  id                     String             @id @default(cuid())
  reference              String             @unique // e.g. VD_TX_89214710
  idempotencyKey         String             @unique // Prevents duplicate execution
  userId                 String
  user                   User               @relation(fields: [userId], references: [id])
  type                   TransactionType
  status                 TransactionStatus  @default(PENDING)
  amountInKobo           BigInt
  feeInKobo              BigInt             @default(0)
  recipientBankCode      String?
  recipientAccountNumber String?
  recipientName          String?
  narration              String?
  partnerReference       String?            // Partner settlement reference
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  ledgerEntries          LedgerEntry[]

  @@index([userId])
  @@index([reference])
  @@index([idempotencyKey])
  @@index([status])
}

model LedgerEntry {
  id                 String             @id @default(cuid())
  walletId           String
  wallet             Wallet             @relation(fields: [walletId], references: [id])
  transactionId      String
  transaction        Transaction        @relation(fields: [transactionId], references: [id])
  type               LedgerEntryType
  amountInKobo       BigInt
  balanceAfterInKobo BigInt
  description        String
  createdAt          DateTime           @default(now())

  @@index([walletId])
  @@index([transactionId])
}

model EphemeralToken {
  id                 String             @id @default(cuid())
  token              String             @unique // Cryptographically secure random token
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber        String
  type               TokenType
  payload            Json?              // e.g. amount, recipient details for authorization
  isUsed             Boolean            @default(false)
  expiresAt          DateTime
  createdAt          DateTime           @default(now())

  @@index([token])
  @@index([phoneNumber])
  @@index([expiresAt])
}

model Beneficiary {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname          String             // e.g. "Chioma", "Mummy", "Alhaji Musa", "Landlord"
  accountName       String             // Legal verified bank name
  accountNumber     String             // 10-digit NUBAN
  bankCode          String             // CBN / NIP bank code
  bankName          String             // e.g. "Guaranty Trust Bank", "Access Bank"
  transferCount     Int                @default(1)
  lastTransferredAt DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, accountNumber, bankCode])
  @@index([userId])
  @@index([nickname])
}

model EmergencyFreezeLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference       String    @unique
  channel         String    // WEB_KILL_SWITCH, ADMIN_PANEL, WHATSAPP_SOS
  ipAddress       String?
  userAgent       String?
  unfrozenAt      DateTime?
  unfrozenBy      String?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

// ==========================================
// ADMIN OPERATIONS & MAKER-CHECKER MODELS
// ==========================================

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  SUPPORT
}

enum AdminActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum AdminActionType {
  REVERSE_TRANSACTION
  UNFREEZE_USER
  MANUAL_ADJUSTMENT
  SWITCH_BANKING_PROVIDER
  UPDATE_SYSTEM_LIMITS
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String
  passwordHash String
  role         AdminRole @default(SUPPORT)
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs        AuditLog[]
  makerRequests    AdminActionRequest[] @relation("MakerRequests")
  checkerReviews   AdminActionRequest[] @relation("CheckerReviews")

  @@index([email])
  @@index([role])
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  targetType  String    // e.g. "USER", "TRANSACTION", "SYSTEM_CONFIG", "ADMIN_ACTION"
  targetId    String?
  beforeState Json?
  afterState  Json?
  reason      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model AdminActionRequest {
  id           String            @id @default(cuid())
  type         AdminActionType
  status       AdminActionStatus @default(PENDING_APPROVAL)
  targetType   String
  targetId     String
  payload      Json
  reason       String
  evidenceUrl  String?
  makerId      String
  maker        AdminUser         @relation("MakerRequests", fields: [makerId], references: [id])
  checkerId    String?
  checker      AdminUser?        @relation("CheckerReviews", fields: [checkerId], references: [id])
  checkerNotes String?
  reviewedAt   DateTime?
  executedAt   DateTime?
  errorMessage String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([makerId])
  @@index([targetId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model ReconciliationBatch {
  id               String                      @id @default(cuid())
  providerName     String
  fileName         String
  totalRows        Int
  matchedCount     Int
  discrepancyCount Int
  uploadedBy       String
  createdAt        DateTime                    @default(now())
  discrepancies    ReconciliationDiscrepancy[]
}

model ReconciliationDiscrepancy {
  id              String              @id @default(cuid())
  batchId         String
  batch           ReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type            String              // INTERNAL_ONLY, PARTNER_ONLY, AMOUNT_MISMATCH, STATUS_MISMATCH
  reference       String
  partnerRef      String?
  internalAmount  BigInt?
  partnerAmount   BigInt?
  internalStatus  String?
  partnerStatus   String?
  isResolved      Boolean             @default(false)
  resolutionNotes String?
  createdAt       DateTime            @default(now())

  @@index([batchId])
  @@index([reference])
}


